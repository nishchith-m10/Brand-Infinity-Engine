# Test Environment Configuration
# Copy this file to .env.test and configure for your test environment

# Supabase Configuration
SUPABASE_URL=your_test_supabase_url_here
SUPABASE_ANON_KEY=your_test_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_test_service_role_key_here

# N8N Configuration (use mock endpoints for tests)
N8N_WEBHOOK_URL=https://mock-n8n.example.com/webhook
N8N_API_KEY=test_n8n_api_key
N8N_WEBHOOK_SECRET=test_webhook_secret_for_signature_verification

# LLM Provider Keys (use 'mock' for local testing)
OPENAI_API_KEY=mock
ANTHROPIC_KEY=mock
GOOGLE_API_KEY=mock
ELEVENLABS_KEY=mock

# Rate Limiting and Caching (use local Redis or mock)
UPSTASH_REDIS_REST_URL=redis://localhost:6379
UPSTASH_REDIS_REST_TOKEN=local_redis_token

# Monitoring and Analytics (optional for tests)
SENTRY_DSN=disabled
ANALYTICS_KEY=disabled

# Test-specific Configuration
NODE_ENV=test
TEST_TIMEOUT=30000
TEST_DATABASE_RESET_ON_STARTUP=true
TEST_USE_REAL_SERVICES=false
TEST_ENABLE_PERFORMANCE_LOGS=true
TEST_MOCK_EXTERNAL_SERVICES=true

# Budget and Cost Configuration for Tests
DEFAULT_TEST_BUDGET=1000.00
TEST_COST_CALCULATOR_MODE=mock
TEST_ENABLE_BUDGET_ENFORCEMENT=true

# Security Testing
TEST_WEBHOOK_SIGNATURE_SECRET=test_secret_for_webhook_signatures
TEST_API_RATE_LIMIT_PER_MINUTE=100
TEST_ENABLE_AUTH_BYPASS=false

# Performance Testing Configuration
PERF_TEST_CONCURRENT_USERS=10
PERF_TEST_DURATION_SECONDS=30
PERF_TEST_RAMP_UP_TIME=5
PERF_TEST_MEMORY_THRESHOLD_MB=512

# Database Testing
DB_TEST_CLEANUP_AFTER_EACH=true
DB_TEST_USE_TRANSACTIONS=true
DB_TEST_SEED_DATA=minimal

# Feature Flags for Tests
TEST_FEATURE_CIRCUIT_BREAKERS=true
TEST_FEATURE_REQUEST_TRACING=true
TEST_FEATURE_BUDGET_TRACKING=true
TEST_FEATURE_RATE_LIMITING=true

# Logging Configuration
LOG_LEVEL=warn
TEST_LOG_TO_FILE=false
TEST_LOG_DIRECTORY=./tests/logs